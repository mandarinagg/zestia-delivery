# Copiar a .env (ignorado por git). Solo valores de desarrollo, nunca secretos reales.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# La API se conecta SIEMPRE con el rol de aplicación (sin BYPASSRLS, no dueño de tablas).
# Si arranca con un rol privilegiado, falla al iniciar. Clave = ZESTIA_APP_PASSWORD de infra/docker/.env.
DATABASE_URL=postgresql://zestia_app:change_me_app_local_only@localhost:5432/zestia
DATABASE_POOL_MAX=10

# Solo para el CLI de Prisma (migraciones: pnpm db:migrate). La API no la lee.
# Clave = ZESTIA_MIGRATOR_PASSWORD de infra/docker/.env.
MIGRATION_DATABASE_URL=postgresql://zestia_migrator:change_me_migrator_local_only@localhost:5432/zestia

# --- Autenticación (issue #14; ver docs/SECURITY.md) ---------------------------------------
# Orígenes del frontend aceptados en requests que cambian estado (CSRF). CSV, sin barra final.
APP_ORIGINS=http://localhost:5173
# Base de los enlaces de los emails (reset de contraseña).
WEB_BASE_URL=http://localhost:5173
# Sesión: inactividad (min) y vencimiento absoluto (h).
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# En desarrollo (http://localhost) la cookie va sin Secure ni prefijo __Host-. Por defecto es
# true fuera de NODE_ENV=development, y en producción no se puede desactivar.
# SESSION_COOKIE_SECURE=false
# Proxies confiables delante de la API (para tomar la IP de X-Forwarded-For). 0 en local.
TRUST_PROXY_HOPS=0
# Rate limit de login (por cuenta e IP, compartido entre instancias vía Postgres).
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_PER_ACCOUNT=5
LOGIN_RATE_MAX_PER_IP=50
# Reset de contraseña: vida del enlace y límite de pedidos.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RATE_WINDOW_MINUTES=60
PASSWORD_RESET_RATE_MAX_PER_ACCOUNT=3
PASSWORD_RESET_RATE_MAX_PER_IP=20

# --- Email (en desarrollo: Mailpit de infra/docker, UI en http://localhost:8025) ------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=ZESTIA DELIVERY <no-reply@zestia-delivery.test>

# --- Solo para `pnpm db:seed` (datos de desarrollo; la API no lo lee) ------------------------
# Superusuario del contenedor local (= POSTGRES_USER/POSTGRES_PASSWORD de infra/docker/.env):
# las tablas tienen RLS forzada y solo él puede dar de alta tenants y usuarios de ejemplo.
SEED_DATABASE_URL=postgresql://zestia_admin:change_me_local_only@localhost:5432/zestia
# Contraseña de TODOS los usuarios sembrados (placeholder de desarrollo, mínimo 12 caracteres).
SEED_USER_PASSWORD=change_me_dev_only
