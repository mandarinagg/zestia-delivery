# Copiar a .env (ignorado por git). Solo valores de desarrollo, nunca secretos reales.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# La API se conecta SIEMPRE con el rol de aplicación (sin BYPASSRLS, no dueño de tablas).
# Si arranca con un rol privilegiado, falla al iniciar. Clave = ZESTIA_APP_PASSWORD de infra/docker/.env.
DATABASE_URL=postgresql://zestia_app:change_me_app_local_only@localhost:5432/zestia
DATABASE_POOL_MAX=10

# Solo para el CLI de Prisma (migraciones: pnpm db:migrate). La API no la lee.
# Clave = ZESTIA_MIGRATOR_PASSWORD de infra/docker/.env.
MIGRATION_DATABASE_URL=postgresql://zestia_migrator:change_me_migrator_local_only@localhost:5432/zestia
